<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>acceptcrypto-net-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcceptCrypto.Domain\AcceptCrypto.Domain.csproj" />
    <ProjectReference Include="..\AcceptCrypto.Infrastructure\AcceptCrypto.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="PaymentPage\Assets\*" LogicalName="AcceptCrypto.Service.PaymentPage.Assets.%(Filename)%(Extension)" />
    <Content Remove="PaymentPage\Assets\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AcceptCrypto.IntegrationTests" />
  </ItemGroup>

</Project>
