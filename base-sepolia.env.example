# Base Sepolia (TESTNET) settings for docker-compose.base-sepolia.yml — see docs/testnet.md.
# Copy to base-sepolia.env (git-ignored via *.env) and fill in. Never commit the filled-in file.

# JSON-RPC endpoint of Base Sepolia (chain 84532). The public https://sepolia.base.org works for a short demo but
# is rate limited; a free provider endpoint (Alchemy, QuickNode, Infura, ...) is more reliable. Often contains an API key.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Merchant API key and webhook signing secret: at least 32 characters, e.g. `openssl rand -hex 32`.
MERCHANT_API_KEY=replace_with_openssl_rand_hex_32
MERCHANT_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32

# Extended PUBLIC key at m/44'/60'/0'/0 of a TESTNET-ONLY mnemonic: `dotnet run --project src/AcceptCrypto.Payer -- xpub new`.
# Never an xprv, never a wallet that holds mainnet funds.
MERCHANT_XPUB=xpub_replace_me

# Optional
# PUBLIC_BASE_URL=http://localhost:5052   # base of payment page links (e.g. a tunnel URL to open them on a phone)
# CHAIN_MAX_BLOCK_RANGE=200               # the public RPC allows 200 blocks per eth_getLogs; set your provider's limit
# CHAIN_CONFIRMATIONS=60                  # N (FR-7); measured Nov 2026: Base Sepolia ≈ 5 blocks per second → ≈ 12 s
